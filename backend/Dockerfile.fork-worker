# syntax=docker/dockerfile:1

# Arbiter fork worker, deployed as its own service. Same application image as
# `Dockerfile.worker`, with the fork queue as the default command instead of the
# match queue:
#
#   celery -A app.workers.celery_app worker \
#       --queues=arbiter.forks --concurrency=1 --loglevel=INFO
#
# A fork is a saved checkpoint: one match's sandbox state at a branch point,
# plus both agents' conversations up to there. Building one replays that branch
# back through the Engine into a fresh sandbox and snapshots the result, so it
# is slower and rarer than hosting a match. It gets its own pool for exactly
# that reason -- a long replay can neither delay a queued match nor be starved
# by one -- and the two pools share only the broker and the code.
#
# This worker never starts a match; starting one *from* a fork is the match
# worker's `arbiter.start_match`. It therefore builds no agents and calls no
# models, which is why it does not need the model provider keys below.
#
# NOTE: the base setup (uv pin, environment, dependency install, user) is
# duplicated across `Dockerfile`, `Dockerfile.worker` and this file. That is
# deliberate: each is self-contained so a platform can build any one of them
# without a shared or published base image. Change the shared part in all three
# together.
#
# The only functional difference from `Dockerfile.worker` is the queue default.
# If your platform lets a service set its own environment, you do not need this
# file at all -- deploy `Dockerfile.worker` with `CELERY_QUEUES=arbiter.forks`
# and skip the third copy.
#
# Postgres and Redis are external, reached through DATABASE_URL and REDIS_URL.
#
# The worker takes no inbound traffic -- the API drives it through Redis, never
# over HTTP -- but hosting platforms (Render, and private services generally)
# refuse to mark a service healthy until something listens on PORT, so the
# container binds that port with a minimal health endpoint (worker_health.py)
# and Celery runs in the foreground behind it.
#
# The API service owns schema migrations: it runs `alembic upgrade head` on
# start, so this image deliberately does not, which keeps the services starting
# at once from racing each other on the same migration.
#
# Required environment:
#   DATABASE_URL            Postgres
#   REDIS_URL               Celery broker
#   E2B_API_KEY             sandbox provider (the default client)
#   SOLARI_API_KEY          sandbox provider, only if SolariClient is selected
#   LOGFIRE_TOKEN           observability; the worker reads it at import
#   PORT                    port to bind for the platform (default 10000)
#
# Deliberately absent, unlike the match worker: the model provider keys and
# ARBITER_BYOK_SECRET. Replaying recorded tool calls builds no agents, so this
# service has no reason to hold a credential it never uses.
#
# Build from this directory:
#   docker build -f Dockerfile.fork-worker -t arbiter-fork-worker backend/

FROM python:3.12-slim

# uv, pinned to the version this project's uv.lock was resolved with.
COPY --from=ghcr.io/astral-sh/uv:0.12.8 /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PYTHONPATH=/app \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Dependencies first, so this layer is reused until pyproject.toml or uv.lock
# change. The app itself is run from the copied source rather than installed,
# which keeps the image to a single copy of the code.
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

COPY app ./app
COPY worker_health.py ./

# Normalise modes: files copied from the host can arrive owner-only (600),
# which the non-root user below would then be unable to import.
RUN chmod -R a+rX /app/app && chmod 644 /app/worker_health.py

RUN useradd --create-home --uid 10001 arbiter
USER arbiter

# Render's default. Only the platform's health check talks to this port.
ENV PORT=10000
EXPOSE 10000

# The fork pool. This one line is the whole reason this image exists; the match
# worker keeps the `arbiter.matches` default from `Dockerfile.worker`.
ENV CELERY_QUEUES=arbiter.forks

# Health checks go to /health (the endpoint answers any path, so `/` works too).
# This names the service in the health body, so the two worker pools are told
# apart in the platform's health output instead of both reporting the generic
# `arbiter-worker`.
ENV ARBITER_SERVICE_NAME=arbiter-fork-worker

# The health endpoint is started first so the platform sees the port open, then
# `exec` hands the container to Celery: it becomes PID 1 and receives the stop
# signal directly, and the container's lifetime is the worker's lifetime.
#
# One fork at a time per worker, matching the match worker: the provider serves
# a single live sandbox, so extra builds queue on the broker rather than
# competing for it.
CMD ["sh", "-c", "python /app/worker_health.py & exec celery -A app.workers.celery_app worker --queues=${CELERY_QUEUES} --concurrency=1 --loglevel=INFO --without-heartbeat"]
