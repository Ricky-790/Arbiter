# syntax=docker/dockerfile:1

# Arbiter Celery worker, deployed as its own service. Same application image as
# `Dockerfile`, with the worker as the default command instead of the API.
#
#   celery -A app.workers.celery_app worker \
#       --queues=arbiter.matches --concurrency=1 --loglevel=INFO
#
# Postgres and Redis are external, reached through DATABASE_URL and REDIS_URL.
#
# The API service owns schema migrations: it runs `alembic upgrade head` on
# start, so this image deliberately does not, which keeps two services starting
# at once from racing each other on the same migration.
#
# Required environment:
#   DATABASE_URL            Postgres
#   REDIS_URL               Celery broker and the match-event pub/sub channel
#   SOLARI_API_KEY          sandbox provider
#   NVIDIA_API_KEY, OPENROUTER_API_KEY, GOOGLE_API_KEY
#                           keys for the free models
#   ARBITER_BYOK_SECRET     encrypts user-supplied keys between API and worker
#   LOGFIRE_TOKEN           observability; the worker reads it at import
#
# Build from this directory:  docker build -f Dockerfile.worker -t arbiter-worker backend/
#
# NOTE: the base setup (uv pin, environment, dependency install, user) is shared
# with `Dockerfile`; change both together.

FROM python:3.12-slim

# uv, pinned to the version this project's uv.lock was resolved with.
COPY --from=ghcr.io/astral-sh/uv:0.12.8 /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PYTHONPATH=/app \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Dependencies first, so this layer is reused until pyproject.toml or uv.lock
# change. The app itself is run from the copied source rather than installed,
# which keeps the image to a single copy of the code.
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

COPY app ./app

# Normalise modes: files copied from the host can arrive owner-only (600),
# which the non-root user below would then be unable to import.
RUN chmod -R a+rX /app/app

RUN useradd --create-home --uid 10001 arbiter
USER arbiter

# One match at a time per worker: Solari hosts a single sandbox, and extra
# matches queue on the broker rather than competing for it.
CMD ["celery", "-A", "app.workers.celery_app", "worker", \
     "--queues=arbiter.matches", "--concurrency=1", "--loglevel=INFO"]
