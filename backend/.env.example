SOLARI_API_KEY=YOUR_API_KEY

#Ai providers
NVIDIA_API_KEY=YOUR_API_KEY
OPENROUTER_API_KEY=
GOOGLE_API_KEY=YOUR_API_KEY
# Redis: Celery broker/result backend and the live match-event pub/sub channel.
REDIS_URL=redis://localhost:6379/0

# Wall-clock limit for one match, enforced by the Engine.
ARBITER_MATCH_TIMEOUT_SECONDS=600

# Passphrase that encrypts user-supplied (BYOK) provider keys while they wait
# for a worker to pick the match up. Must be identical for the API and the
# worker processes. Any non-empty string works; use a long random one.
# Without it, requests that use a BYOK model are rejected.
ARBITER_BYOK_SECRET=secret

# How long an unredeemed BYOK key survives, in seconds.
ARBITER_BYOK_TTL_SECONDS=3600

# RSA key pair the browser encrypts api-key fields with before sending them.
# Generate with:  uv run python -m app.secrets.gen_rsa_keys
# Paste the two lines it prints. Keep the private one secret: it is this
# deployment's decryption key. Setting only the private value is enough -- the
# public half is derived from it. Leave both empty and the transport is off:
# the public-key endpoint returns 503 and api-key fields are read as plaintext.
ARBITER_RSA_PUBLIC_KEY=
ARBITER_RSA_PRIVATE_KEY=
